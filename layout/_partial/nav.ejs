<nav id="nav">
  <header class="header">
    <a href="<%= url_for('/') %>" class="title"><%= theme.nav.title %></a>
  </header>
  <div class="ctnWrap">
    <div class="icons">
      <% social_links().forEach(function(item) { %>
        <a href="<%= url_for(item.url) %>" target="_blank" aria-label="<%= item.key %>" class="nav-icn iconfont icon-<%= item.key.toLowerCase() %>"></a>
      <% }); %>
    </div>
    <div class="menu">
      <% menu_links().forEach(function(item) { %>
        <a href="<%= url_for(item.path) %>" class="nav-menu <%= is_current(item.path) ? 'z-active' : '' %>"><%= item.key.toUpperCase() %></a>
      <% }); %>
    </div>
  </div>
</nav>