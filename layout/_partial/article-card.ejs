<div class="project-card project-card-continuous">
  <% if (post.photos[0]) { %>
    <div class="imgWrap">
      <img src="<%= url_for(post.photos[0]) %>" alt="" <%- clover_card_image_attrs(post.photos[0], typeof image_index === 'undefined' ? 0 : image_index) %> />
    </div>
  <% } %>
  <div class="ctnWrap">
    <a href="<%- url_for(post.path) %>" class="title"><%= post.title %></a>
    <section class="desc"><%- partial('excerpt', { post: post }) %></section>
    <p class="sub"><%- date(post.date, 'MMM D, YYYY') %></p>
  </div>
</div>