<section class="article article-post">
  <% if (post.cover !== false && post.photos && post.photos[0]) { %>
    <img class="cover" src="<%= url_for(post.photos[0]) %>" alt="" <%- clover_card_image_attrs(post.photos[0]) %> loading="eager" />
  <% } %>
  <h1 class="title"><%= post.title %></h1>
  <p class="sub"><%- date(post.date, 'MMM D, YYYY') %></p>
  <article class="content">
    <%- clover_body_images(post.more, post.path) %>
  </article>
  <footer class="f-cf">
    <% if (post.prev) { %>
      <a href="<%- url_for(post.prev.path) %>" class="link f-fl"><span class="footer-icn iconfont icon-arrow-left"></span><%= post.prev.title %></a>
    <% } %>
    <% if (post.next) { %>
      <a href="<%- url_for(post.next.path) %>" class="link f-fr"><%= post.next.title %><span class="footer-icn iconfont icon-arrow-right"></span></a>
    <% } %>
  </footer>
</section>