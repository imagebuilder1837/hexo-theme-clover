<h1 class="visually-hidden"><%= clover_page_title() %></h1>
<% if (page.category) { %>
  <%- partial('_partial/card-list', { posts: page.posts, card_context: 'category' }) %>
<% } else { %>
  <%- partial('_partial/grouped-posts', { groups: clover_browse_groups('category') }) %>
<% } %>
<%- partial('_partial/pagination') %>
