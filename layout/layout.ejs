<%- partial('_partial/head') %>
<% const layout = is_home() ? 'home' : is_post() ? 'post' : is_category() ? 'category' : is_tag() ? 'tag' : is_archive() ? 'archive' : page.layout || 'page'; %>
<body data-layout="<%= layout %>" style="
<% if (theme.background.image) { %>
  background: url(<%= url_for(theme.background.image) %>) center center no-repeat;
  background-size: contain;
<% } %>
<% if (theme.background.color) { %>
  background-color: <%= theme.background.color %>
<% } %>
">
  <div id="container">
    <%- partial('_partial/nav') %>
    <main id="main"><%- body %></main>
    <%- partial('_partial/footer') %>
  </div>
</body>
</html>