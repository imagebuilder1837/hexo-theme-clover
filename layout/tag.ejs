<h1 class="visually-hidden"><%= clover_page_title() %></h1>
<% if (page.tag) { %>
  <% let imageIndex = 0; page.posts.each(function(post){ %>
    <%- partial('_partial/' + (theme.card_style.tag || 'article-card'), { post: post, image_index: post.photos[0] ? imageIndex++ : imageIndex }) %>
  <% }) %>
  <%- partial('_partial/pagination') %>
<% } else { %>
  <section class="tagcloud">
    <%- tagcloud({
      min_font: 12, 
      max_font: 30, 
      amount: 300, 
      color: true, 
      start_color: '#aaa', 
      end_color: '#333',
    }) %>
  </section>
<% } %>